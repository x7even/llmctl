# Secrets and runtime state — never commit
config/mcp.json
.rollback/
config/models.yaml.bak
.env
*.pid
*.log
logs/

# vLLM/Triton compilation caches — large, machine-specific, regenerated on first boot.
# No trailing slash: in a git worktree these are usually symlinks to the main checkout's
# caches (scripts/llmkv resolves __LLMSTACK_DIR__ to its own repo root, so a worktree would
# otherwise mount empty cache dirs and cold-compile), and a "dir/" pattern does not match a
# symlink — which would leave an absolute path to someone's home directory committable.
.vllm-cache
.triton-cache

# Built/downloaded binaries
bin/llama-swap
bin/llama-swap-ui
bin/llmpanel
tui/tui

# Python cache
__pycache__/
*.pyc
*.pyo

# Model files (live at /mnt/models/llm, not here)
*.gguf
*.safetensors
*.bin

# Editor / OS noise
.DS_Store
*.swp
*~

# llmband calibration is per-host: a committed baseline would silently misjudge another rig.
config/band-baselines.json
